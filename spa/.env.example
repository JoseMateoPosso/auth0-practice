# Datos de la aplicación SPA en Auth0 (Applications > tu SPA > Settings)
VITE_AUTH0_DOMAIN=TU-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=TU_CLIENT_ID_DE_LA_SPA

# Identifier de la API en Auth0 (el mismo que AUTH0_AUDIENCE en api/.env)
VITE_AUTH0_AUDIENCE=https://api.practica.local

# Namespace del claim de roles (el mismo que NAMESPACE en action/add-roles-claim.js)
VITE_CLAIM_NAMESPACE=https://practica.local

# Opcional
VITE_API_URL=http://localhost:3001
